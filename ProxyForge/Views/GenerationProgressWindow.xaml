<Window x:Class="ProxyForge.Views.GenerationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:root="clr-namespace:ProxyForge"
        xmlns:vm="clr-namespace:ProxyForge.ViewModels"
        xmlns:views="clr-namespace:ProxyForge.Views"
        xmlns:host="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type vm:GenerationProgressViewModel}}"
        Title="{x:Static root:Texts.ProxyForge}"
        Width="420" MaxHeight="520" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False">
    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static root:Texts.GeneratingProxies}" VerticalAlignment="Center"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding SourcePath}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Row="1">
                                <ProgressBar Minimum="0" Maximum="100" Value="0" IsIndeterminate="{Binding IsWaiting}"/>
                                <views:ChunkCoverageBar Margin="1" Coverage="{Binding Coverage}"/>
                                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <UniformGrid Grid.Row="2" Rows="1" Columns="2">
            <Button Content="{x:Static host:Texts.CancelButtonContent}" Command="{Binding CancelCommand}"/>
            <Button Content="{x:Static host:Texts.CloseButtonContent}" Click="OnCloseClick"/>
        </UniformGrid>
    </Grid>
</Window>
