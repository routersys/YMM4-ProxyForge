<UserControl x:Class="ProxyForge.Views.ProxyForgeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:ProxyForge"
             xmlns:vm="clr-namespace:ProxyForge.ViewModels"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type={x:Type vm:ProxyForgeSettingsViewModel}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Expander Header="{x:Static root:Texts.ProxyForge}" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static root:Texts.PluginOrder}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding PluginOrderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Width="26" Command="{Binding MoveToFrontCommand}" ToolTip="{x:Static root:Texts.MoveToFront}"
                                Content="{DynamicResource {x:Static icons:IconKeys.ArrowCollapseUp}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPluginFirst}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static root:Texts.FFmpegLabel}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FFmpegText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding GenerationText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static root:Texts.ShowProgressWindow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <c:ToggleSlider Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Value="{Binding Settings.ShowsProgressWindow}"/>
                </Grid>
            </Expander>

            <Expander Header="{x:Static root:Texts.ProxySettings}" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static root:Texts.UseProxy}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <c:ToggleSlider Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Value="{Binding Settings.IsEnabled}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static root:Texts.GenerateAutomatically}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <c:ToggleSlider Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Value="{Binding Settings.GeneratesAutomatically}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static root:Texts.ScaleLabel}" VerticalAlignment="Center"/>
                    <c:TextBoxSlider Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                     Value="{Binding Settings.Scale}"
                                     StringFormat="F0" Unit="%" DefaultValue="50"
                                     DefaultMin="10" DefaultMax="100" Min="10" Max="100" Delay="-1"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static root:Texts.MinimumFileSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <c:TextBoxSlider Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                     Value="{Binding Settings.MinimumFileSizeMegabytes}"
                                     StringFormat="F0" Unit="MB" DefaultValue="100"
                                     DefaultMin="1" DefaultMax="1000" Min="1" Max="100000" Delay="-1"/>
                </Grid>
            </Expander>

            <Expander Header="{x:Static root:Texts.EncodingSettings}" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static root:Texts.BitrateScaleLabel}" VerticalAlignment="Center"/>
                    <c:TextBoxSlider Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                     Value="{Binding Settings.BitrateScale}"
                                     StringFormat="F0" Unit="%" DefaultValue="50"
                                     DefaultMin="10" DefaultMax="200" Min="1" Max="200" Delay="-1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static root:Texts.KeyFrameIntervalLabel}" VerticalAlignment="Center"/>
                    <c:TextBoxSlider Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                     Value="{Binding Settings.KeyFrameInterval}"
                                     StringFormat="F0" Unit="{x:Static root:Texts.UnitFrames}" DefaultValue="30"
                                     DefaultMin="1" DefaultMax="120" Min="1" Max="300" Delay="-1"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static root:Texts.UseHardwareEncoder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <c:ToggleSlider Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Value="{Binding Settings.UsesHardwareEncoder}"/>
                </Grid>
            </Expander>

            <Expander Header="{x:Static root:Texts.CacheSettings}" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static root:Texts.CacheLimit}" VerticalAlignment="Center"/>
                        <c:TextBoxSlider Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                         Value="{Binding Settings.CacheLimitGigabytes}"
                                         StringFormat="F0" Unit="GB" DefaultValue="10"
                                         DefaultMin="1" DefaultMax="100" Min="1" Max="1024" Delay="-1"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding CacheSummary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="26" Command="{Binding RefreshCommand}" ToolTip="{x:Static root:Texts.Refresh}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.Refresh}}"/>
                            <Button Width="26" Command="{Binding OpenDirectoryCommand}" ToolTip="{x:Static root:Texts.OpenCacheDirectory}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.FolderOpenOutline}}"/>
                            <Button Width="26" Command="{Binding RemoveEntryCommand}" ToolTip="{x:Static root:Texts.RemoveCacheEntry}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.Minus}}"/>
                            <Button Width="26" Command="{Binding ClearCommand}" ToolTip="{x:Static root:Texts.ClearCache}"
                                    Content="{DynamicResource {x:Static icons:IconKeys.DeleteSweepOutline}}"/>
                        </StackPanel>
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static root:Texts.ColumnFileName}" DisplayMemberBinding="{Binding FileName}" Width="260"/>
                                <GridViewColumn Header="{x:Static root:Texts.ColumnResolution}" DisplayMemberBinding="{Binding Resolution}" Width="100"/>
                                <GridViewColumn Header="{x:Static root:Texts.ColumnScale}" DisplayMemberBinding="{Binding Scale}" Width="60"/>
                                <GridViewColumn Header="{x:Static root:Texts.ColumnSize}" DisplayMemberBinding="{Binding Size}" Width="90"/>
                                <GridViewColumn Header="{x:Static root:Texts.ColumnLastUsed}" DisplayMemberBinding="{Binding LastUsed}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
